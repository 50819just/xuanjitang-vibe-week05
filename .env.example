# 只允許綠界官方測試環境；不得填入正式商家金鑰。
PORT=3005
APP_BASE_URL=http://localhost:3005
FRONTEND_BASE_URL=http://localhost:5175
ECPAY_ENV=stage
DEMO_CONFIRM_ENABLED=true
# 本機可不填 API 網址，會使用 localhost:3005。
VITE_API_BASE_URL=
# Render 部署時 APP_BASE_URL 必須是該新服務的公開 HTTPS 網址。
# Pages 建置請在 GitHub Actions variables 設定 VITE_API_BASE_URL。
